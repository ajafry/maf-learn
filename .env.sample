# Copy this file to .env, then replace the placeholder values.
# Authentication uses Microsoft Entra ID through DefaultAzureCredential.
# Run `az login` before executing the notebooks; do not add API keys here.

FOUNDRY_PROJECT_ENDPOINT=https://YOUR-PROJECT.services.ai.azure.com
FOUNDRY_MODEL=YOUR_MODEL_DEPLOYMENT_NAME

# Used by lesson 05 to connect to an agent that already exists in Foundry.
# Leave blank until you reach that lesson.
FOUNDRY_AGENT_NAME=

# Optional for a versioned Prompt Agent. Hosted Agents do not need a version.
FOUNDRY_AGENT_VERSION=
